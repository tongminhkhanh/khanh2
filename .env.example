# ============================================
# CẤU HÌNH MÔI TRƯỜNG - ENVIRONMENT VARIABLES
# ============================================
# Copy file này thành .env và điền thông tin thực tế
# KHÔNG BAO GIỜ push file .env lên GitHub!

# MongoDB Connection String
# Local: mongodb://localhost:27017/school-news
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/school-news
MONGODB_URI=mongodb://localhost:27017/school-news

# JWT Secret Key (PHẢI thay đổi trong production!)
# Tạo key mạnh: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Server Port (mặc định 3000)
PORT=3000

# Node Environment (development hoặc production)
NODE_ENV=development

# Cloudinary Configuration (for image uploads)
# Get these from https://console.cloudinary.com/
CLOUDINARY_API_KEY="993365762139559"
CLOUDINARY_API_SECRET="0HV0SvOPUHAL5649-aaLZLRu9oY"
CLOUDINARY_CLOUD_NAME="dwv7hot9x"

# ============================================
# AI CONTENT GENERATOR CONFIGURATION
# ============================================
# AI Provider: 'gemini' (recommended) or 'openai'
AI_PROVIDER=gemini

# Gemini API Key (Free tier available)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Paid, alternative option)
# OPENAI_API_KEY=your_openai_api_key
